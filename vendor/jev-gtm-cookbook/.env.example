# Copy to .env and paste your key from https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Optional. Pin a version (e.g. jev-1.13.0) once you have tuned your cutoffs.
# JEV_MODEL=jev-latest

# Optional. Port for the localhost dashboard.
# PORT=4173

# Optional. Set to 1 to use made-up answers instead of calling Jev (no key needed).
# JEV_MOCK=1

# Optional. Enrichment providers for `node src/cli.js enrich <provider>`. Only set the ones you use.
# PROSPEO_API_KEY=
# LEADMAGIC_API_KEY=
# BLITZ_API_KEY=
# MOLTSETS_API_KEY=
