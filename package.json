{
  "name": "linkedin-outreach",
  "private": true,
  "type": "module",
  "description": "OptiFlowCX + founder LinkedIn content engine: post calendar, branded image renderer, official-API publisher and a human-in-the-loop outreach queue.",
  "scripts": {
    "render": "node scripts/render-images.mjs",
    "post": "node scripts/publish.mjs",
    "queue": "node scripts/outreach-queue.mjs",
    "preview": "node scripts/build-preview.mjs",
    "network:demo": "cd vendor/jev-gtm-cookbook && JEV_MOCK=1 node src/cli.js demo",
    "network:score": "node vendor/jev-gtm-cookbook/src/cli.js score",
    "network:dashboard": "node vendor/jev-gtm-cookbook/src/cli.js serve",
    "network:queue": "node scripts/network-to-queue.mjs",
    "deals": "python3 vendor/jev-lead-scorer/outreach.py",
    "followups": "python3 vendor/jev-lead-scorer/followup.py",
    "deals:demo": "cd vendor/jev-lead-scorer && JEV_STUB=1 python3 demo.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "js-yaml": "^4.1.0",
    "playwright": "1.56.1"
  }
}
